<?xml version="1.0" encoding="utf-8"?>
<!-- 明文流量白名单：仅在家庭内网 http 部署时需要；
     若站点已配置 HTTPS，可删除或清空本文件 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
