# ============ 小书童学习系统 · 环境变量配置 ============
# 复制此文件为 .env 后按需修改

# --- 端口 ---
CORE_PORT=8080
WEB_PORT=8090
# 孩子端 PWA 端口
KID_PORT=8091

# --- 运行模式 ---
SERVER_MODE=release
LOG_LEVEL=info

# --- 数据库 ---
DB_USER=postgres
DB_PASSWORD=postgres_change_me
DB_NAME=littlescholar

# --- 安全密钥（务必修改！）---
# JWT 签名密钥，建议 32 位以上随机字符串
JWT_SECRET=please-change-to-a-random-32-chars-secret
# Cookie / APIKey 加密密钥，建议 32 位以上随机字符串
COOKIE_ENCRYPT_KEY=please-change-to-a-random-32-chars-key

# --- 初始管理员 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- PanSou ---
# 若在 pansou 中启用了 AUTH_ENABLED，请填写这里
PANSOU_TOKEN=
PANSOU_PASSWORD=pansou123

# --- PanCheck ---
PANCHECK_PASSWORD=pancheck123
PANCHECK_DB_PASSWORD=pancheck123

# --- 转码 ---
# 同时转码路数，建议 = CPU 核数 / 2
TRANSCODE_CONCURRENCY=2
# 产物缓存上限（GB）。超过后按「最久未播放」优先淘汰。
# 一个 720p 产物约 700MB～2GB，20GB 约可留住 28 部影片。
TRANSCODE_CACHE_MAX_GB=20
# 产物闲置天数，超过则清理。播放时会刷新访问时间，
# 所以孩子反复看的内容不会被清掉。
TRANSCODE_CACHE_TTL_DAYS=30

# --- 资源存活巡检 ---
# 定时巡检开关（每天一次）。关闭后仍可在后台「资源巡检」页手动触发。
ALIVE_ENABLED=true
# 单批送检数量
ALIVE_BATCH_SIZE=30
# 每批之间的间隔秒数，避免把 PanSou/PanCheck 打挂
ALIVE_INTERVAL_SECONDS=2
# 连续失败几次才判定资源失效。单次判定可靠性有限
# （网盘限流、对面抖动都会造成假阳性），建议 2~3。
ALIVE_DEAD_THRESHOLD=2
# 超过这么久未检查的资源需要重新检查
ALIVE_STALE_HOURS=72
